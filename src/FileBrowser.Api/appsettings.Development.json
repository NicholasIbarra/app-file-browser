{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileBrowser": {
    "Provider": "Local",
    "HomeDirectory": "./local-storage",
    "CreateIfMissing": true,
    "Azure": {
      "ContainerName": "azure-provider"
    }
  },
  "OpenAI": {
    "AzureOpenAI": {
      "Enabled": false
    }
  }
}
