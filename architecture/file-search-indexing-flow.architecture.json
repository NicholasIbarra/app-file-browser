  "cards": [
    {
      "dot": "cyan",
      "title": "Verified behavior",
      "items": [
        "Startup awaits RebuildAsync; FileSearchIndex scans System.IO directly. Searches see the empty Snapshot until atomic publication; SemaphoreSlim serializes updates.",
        "Created/upload and copied → AddOrUpdateAsync; moved → MoveAsync; deleted → RemoveAsync. No Changed event or ready flag exists."
      ]
    },
    {
      "dot": "orange",
      "title": "Proposed watcher normalization",
      "items": [
        "No watcher exists, so external and scan-time changes may be missed. Start monitoring first; queue callbacks and buffer until snapshot publication.",
        "Copy is Created; Changed refreshes; rename removes/adds; boundary moves may be delete + create. Normalize, debounce, retry incomplete writes, and reconcile gaps."
      ]
    }
  ]
